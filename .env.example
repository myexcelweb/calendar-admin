# Copy this file to ".env" (same folder), fill in the values, then restart "npm run dev".
#
# Get the values from: Firebase console -> project "calendar-app-4da53" (the project the
# Android app reads) -> Project settings -> General -> "Your apps" -> the Web app (</>)
# -> SDK setup and configuration -> Config.
# If there is no Web app listed there yet, one has to be added first (Add app -> Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=calendar-app-4da53.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=calendar-app-4da53
VITE_FIREBASE_STORAGE_BUCKET=calendar-app-4da53.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=873464877083
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google accounts allowed to sign in to the admin website (comma-separated)
VITE_ADMIN_EMAILS=myexcelweb@gmail.com
