rules_version = '2';

// Schema (professional, hierarchical - mirrors "year/month/day"):
//
//   calendars/{year}                                    e.g. calendars/2026
//   calendars/{year}/months/{month}                      e.g. .../months/01   ("2026/january")
//       optionalLeaveDays: [1, 3, 7, 26]
//       extraWorkingDays:  [15, 17]
//       note: "Lok Adalat on 13 Jan26"
//   calendars/{year}/months/{month}/holidays/{day}       e.g. .../holidays/26 ("2026/january/26")
//       name: "Independence Day"
//       date: "2026-01-26"
//
// Everyone (incl. the unauthenticated Android app) can read. Only the admin
// account can write.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'myexcelweb@gmail.com';
    }

    // Calendar data: year -> months -> (fields) + holidays subcollection
    match /calendars/{year} {
      allow read: if true;
      allow write: if isAdmin();

      match /months/{month} {
        allow read: if true;
        allow write: if isAdmin();

        match /holidays/{day} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    // System Metadata
    match /system/metadata {
      allow read: if true;
      allow write: if isAdmin();
    }
    // User Events (per-user data written by the app itself)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Temp
    match /temp/{document=**} {
      allow read, write: if request.auth != null;
    }

    // --- Legacy collections (pre-migration). Kept read-only-by-admin so
    // nothing else can write stray data into them. Safe to delete this
    // whole block (and the collections themselves) once migrate.js has
    // run and the Android app build has been updated to the new schema.
    match /public_holidays/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /optional_leaves/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /monthly_notes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /extra_working_days/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
